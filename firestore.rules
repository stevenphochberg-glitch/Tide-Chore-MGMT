rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Household collection for sync codes and shared state
    match /households/{householdId} {
      allow read, write: if request.auth != null;

      // Subcollection for tasks / chores
      match /chores/{choreId} {
        allow read, write: if request.auth != null;
      }
    }

    // Individual user profile session data
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
